# Servidor
PORT=3000
NODE_ENV=development

# Sesión: usa un valor largo y propio en tu .env (si falta, el servidor no arranca)
SESSION_SECRET=cambia-esto

# Base de datos SQLite (ruta del archivo, relativa a la raíz del proyecto o absoluta)
DATABASE_PATH=db/servicerca.db

# URL pública de la aplicación: se usa para armar los enlaces de los correos
APP_URL=http://localhost:3000

# Zona horaria para mostrar las fechas (la base guarda UTC). Por defecto America/Mexico_City
ZONA_HORARIA=America/Mexico_City

# Correo (SMTP). Para desarrollo usa Ethereal: `npm run mail:ethereal` imprime estos valores.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ServiCerca <no-reply@servicerca.local>

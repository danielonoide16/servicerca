<%- include('../partials/header', { titulo: 'Enviar propuesta' }) %>
<section class="tarjeta formulario">
  <h1>Enviar propuesta</h1>
  <p><strong><%= solicitud.oficio %> en <%= solicitud.zona %>:</strong> <%= solicitud.descripcion %></p>

  <%- include('../partials/errores', { errores: errores }) %>

  <form action="/propuestas/nueva/<%= solicitud.id %>" method="post" novalidate>
    <label for="precio">Precio estimado (MXN)</label>
    <input type="number" id="precio" name="precio" value="<%= valores.precio %>" min="1" step="0.01" placeholder="Por ejemplo: 450" required>

    <label for="disponibilidad">Disponibilidad</label>
    <input type="text" id="disponibilidad" name="disponibilidad" value="<%= valores.disponibilidad %>" maxlength="100" placeholder="Por ejemplo: mañana por la tarde" required>

    <label for="mensaje">Mensaje para el cliente</label>
    <textarea id="mensaje" name="mensaje" maxlength="500" placeholder="Cuéntale cómo harías el trabajo"><%= valores.mensaje %></textarea>
    <small>Opcional. Máximo 500 caracteres.</small>

    <button type="submit">Enviar propuesta</button>
  </form>
</section>
<%- include('../partials/footer') %>

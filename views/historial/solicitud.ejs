<%- include('../partials/header', { titulo: 'Detalle de la solicitud' }) %>
<section class="tarjeta">
  <h1>Solicitud de <%= solicitud.oficio %></h1>
  <p><span class="estado estado-<%= solicitud.estado %>"><%= solicitud.estado %></span></p>
  <p><strong>Descripción:</strong> <%= solicitud.descripcion %></p>
  <p><strong>Zona:</strong> <%= solicitud.zona %></p>
  <p><strong>Publicada el:</strong> <%= solicitud.fecha %></p>

  <% if (resena) { %>
    <h2>Tu reseña</h2>
    <p><strong>Calificación:</strong> <%= resena.calificacion %> de 5</p>
    <% if (resena.comentario) { %>
      <p><%= resena.comentario %></p>
    <% } %>
  <% } %>

  <p><a href="/historial">Volver a mi historial</a></p>
</section>
<%- include('../partials/footer') %>

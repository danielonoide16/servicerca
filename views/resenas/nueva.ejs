<%- include('../partials/header', { titulo: 'Dejar reseña' }) %>
<section class="tarjeta formulario">
  <h1>Reseña del trabajo</h1>
  <p><strong><%= solicitud.oficio %>:</strong> <%= solicitud.descripcion %></p>

  <%- include('../partials/errores', { errores: errores }) %>

  <form action="/resenas/nueva/<%= solicitud.id %>" method="post" novalidate>
    <label>Calificación</label>
    <% for (let n = limites.CALIFICACION_MIN; n <= limites.CALIFICACION_MAX; n++) { %>
      <label class="casilla">
        <input type="radio" name="calificacion" value="<%= n %>" <%= valores.calificacion === n ? 'checked' : '' %> required>
        <%= n %> <%= n === 1 ? 'estrella' : 'estrellas' %>
      </label>
    <% } %>

    <label for="comentario">Comentario</label>
    <textarea id="comentario" name="comentario" maxlength="<%= limites.COMENTARIO_MAX %>" placeholder="¿Cómo fue el trabajo?"><%= valores.comentario %></textarea>
    <small>Opcional. Máximo <%= limites.COMENTARIO_MAX %> caracteres.</small>

    <button type="submit">Guardar reseña</button>
  </form>
</section>
<%- include('../partials/footer') %>

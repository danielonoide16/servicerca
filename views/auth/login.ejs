<%- include('../partials/header', { titulo: 'Iniciar sesión' }) %>
<section class="tarjeta formulario">
  <h1>Iniciar sesión</h1>

  <% if (locals.registrado) { %>
    <p class="mensaje">Cuenta creada. Ahora puedes iniciar sesión.</p>
  <% } %>
  <%- include('../partials/errores', { errores: locals.errores || [] }) %>

  <form action="/login" method="post" novalidate>
    <label for="correo">Correo</label>
    <input type="email" id="correo" name="correo" value="<%= (locals.valores && valores.correo) || '' %>" required autofocus>

    <label for="contrasena">Contraseña</label>
    <input type="password" id="contrasena" name="contrasena" required>

    <button type="submit">Entrar</button>
  </form>

  <p>¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
</section>
<%- include('../partials/footer') %>

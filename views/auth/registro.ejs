<%- include('../partials/header', { titulo: 'Registrarse' }) %>
<% const v = locals.valores || {}; %>
<section class="tarjeta formulario">
  <h1>Crear cuenta</h1>

  <%- include('../partials/errores', { errores: locals.errores || [] }) %>

  <form action="/registro" method="post" novalidate>
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= v.nombre || '' %>" maxlength="100" required autofocus>

    <label for="correo">Correo</label>
    <input type="email" id="correo" name="correo" value="<%= v.correo || '' %>" required>

    <label for="contrasena">Contraseña</label>
    <input type="password" id="contrasena" name="contrasena" minlength="8" maxlength="72" required>
    <small>Mínimo 8 caracteres, con al menos una letra y un número.</small>

    <label for="rol">Quiero registrarme como</label>
    <select id="rol" name="rol" required>
      <option value="">Selecciona una opción</option>
      <option value="cliente" <%= v.rol === 'cliente' ? 'selected' : '' %>>Cliente (necesito un servicio)</option>
      <option value="prestador" <%= v.rol === 'prestador' ? 'selected' : '' %>>Prestador (ofrezco un servicio)</option>
    </select>

    <label class="casilla">
      <input type="checkbox" name="aceptaPrivacidad" value="on" required>
      He leído y acepto el <a href="/privacidad" target="_blank" rel="noopener">aviso de privacidad</a>
    </label>

    <button type="submit">Crear cuenta</button>
  </form>

  <p>¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
</section>
<%- include('../partials/footer') %>
